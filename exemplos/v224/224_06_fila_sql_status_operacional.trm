função tarefa(payload)
    retorne payload["ok"]
fim

assíncrona função principal()
    fila = fila_criar_com_backend("status_sql", "sql", {
        "dsn": "sqlite:///.local/v224/jobs_status.db"
    })
    aguarde fila_enfileirar(fila, tarefa, {"ok": verdadeiro}, 1, 5.0, "status-1")

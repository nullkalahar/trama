função upload(req)
    arq = req["arquivos"]["documento"][0]
    retorne {"status": 200, "json": {"ok": verdadeiro, "arquivo": arq["nome_arquivo"], "tamanho": arq["tamanho"]}}
fim

assíncrona função principal()
    app = web_criar_app()
    web_rota(app, "POST", "/upload", upload)
    exibir("roteie /upload com contrato multipart e limites operacionais")
fim

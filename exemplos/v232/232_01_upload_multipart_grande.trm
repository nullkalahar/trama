função upload(req)
    arq = req["arquivos"]["avatar"][0]
    retorne {"status": 200, "json": {"ok": verdadeiro, "streaming": arq["streaming"], "temp": arq["caminho_temporario"], "bytes": arq["tamanho"]}}
fim

assíncrona função principal()
    app = web_criar_app()
    web_rota(app, "POST", "/upload-grande", upload)
    exibir("suba multipart grande em /upload-grande")
fim

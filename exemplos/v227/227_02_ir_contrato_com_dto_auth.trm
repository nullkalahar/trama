função criar(req)
    retorne {"status": 201, "json": {"ok": verdadeiro, "dados": req["corpo"], "meta": {"v": "v2"}}}
fim

assíncrona função principal()
    app = web_criar_app()
    dto = {"corpo": {"tipo": "objeto", "campos": {"nome": {"tipo": "texto", "obrigatorio": verdadeiro}}}}
    contrato = {"versao_padrao": "v2", "versoes": {"v2": {"campos_obrigatorios": ["ok", "dados", "meta"]}}}
    web_rota_dto(app, "POST", "/api/v1/usuarios", criar, dto, contrato, nulo, {"jwt_segredo": "segredo"})
    ir = web_gerar_ir_contrato(app, "API Auth", "2.1.27")
    exibir(ir["rotas"][0]["autenticacao"]["jwt_ativo"])
fim

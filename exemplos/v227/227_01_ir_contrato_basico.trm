função ping(req)
    retorne {"status": 200, "json": {"ok": verdadeiro, "dados": {"pong": verdadeiro}, "meta": {"v": "v1"}}}
fim

assíncrona função principal()
    app = web_criar_app()
    web_rota(app, "GET", "/api/v1/ping/:id", ping)
    ir = web_gerar_ir_contrato(app, "API IR", "2.1.27", "http://127.0.0.1:8080")
    exibir(ir["ir_contrato"])
fim

            "efeito": "permitir",
            "acao": "doc:ler",
            "recurso": {"tipo": "documento", "id": "doc-publico"}
        }
    ], "negar")

    out = autorizacao_politicas_avaliar(
        politicas,
        {"id": "u2", "papeis": ["guest"]},
